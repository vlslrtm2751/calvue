{
  "name": "calvue",
  "version": "0.3.0",
  "description": "Vue 3 component library for a calendar UI widget",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlslrtm2751/calvue.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "play": "vite --config playground/vite.config.ts",
    "typecheck": "vue-tsc --noEmit --project tsconfig.app.json"
  },
  "peerDependencies": {
    "@vueuse/core": "^11.0.0",
    "dayjs": "^1.11.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/tsconfig": "^0.5.0",
    "@vueuse/core": "^11.0.0",
    "dayjs": "^1.11.0",
    "typescript": "^5.4.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.9.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  }
}
